{
  "manifest_version": 3,
  "name": "OLX Workspace",
  "version": "1.0.0",
  "description": "Análise de anúncios OLX com IA",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["https://*.olx.com.br/*", "https://api.deepseek.com/*", "https://api.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.olx.com.br/*carros-vans-e-utilitarios*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OLX Workspace"
  },
  "options_ui": {
    "page": "popup.html?tab=1",
    "open_in_tab": true
  }
}
